export default function KhetKartTracking() {
  const [tokens, setTokens] = useState(INITIAL_TOKENS);
  const [activeRole, setActiveRole] = useState("Farmer");
  const [showNewModal, setShowNewModal] = useState(false);
  const [newForm, setNewForm] = useState({ farmerName: "", residueType: "Paddy Straw", qty: 200 });
  const tickRef = useRef(null);

  const advanceToken = useCallback((tokenId, stageId, forcedCoords) => {
    setTokens(prev => prev.map(token => {
      if (token.id !== tokenId) return token;

      const newCheckpoints = token.checkpoints.map((cp, i) => {
        const stage = STAGES[i];
        if (stage.id === stageId) {
          return {
            ...cp,
            status: "completed",
            timestamp: now(),
            coords: forcedCoords || cp.coords || genCoords(),
          };
        }
        if (stage.id === stageId + 1 && stageId < 12) {
          return { ...cp, status: "active" };
        }
        return cp;
      });

      const nextStage = stageId < 12 ? stageId + 1 : 12;
      const progress = Math.min(100, Math.round((nextStage / 12) * 100));
      const transparencyScore = Math.min(100, token.transparencyScore + Math.floor(8 + Math.random() * 5));
      const processingETA = nextStage >= 9 ? `~${Math.floor(Math.random() * 3) + 1} hrs` : token.processingETA;
      const paymentStatus = stageId === 11 ? "released" : token.paymentStatus;

      const stageName = STAGES.find(s => s.id === stageId)?.label || "";
      const newEntry = {
        time: now(),
        msg: `✓ ${stageName} confirmed by ${STAGES.find(s => s.id === stageId)?.role}`,
        type: "success"
      };

      return {
        ...token,
        currentStage: nextStage,
        progress,
        transparencyScore,
        processingETA,
        paymentStatus,
        checkpoints: newCheckpoints,
        activityFeed: [...token.activityFeed, newEntry],
        coords: forcedCoords || token.coords,
      };
    }));
  }, []);

  // Simulate live GPS updates every 8s for in-transit tokens
  useEffect(() => {
    tickRef.current = setInterval(() => {
      setTokens(prev => prev.map(token => {
        if (token.currentStage === 7) {
          const newCoords = genCoords();
          const newEntry = { time: now(), msg: `📡 GPS update: ${newCoords.lat}, ${newCoords.lng}`, type: "info" };
          return {
            ...token,
            coords: newCoords,
            activityFeed: [...token.activityFeed.slice(-19), newEntry],
          };
        }
        return token;
      }));
    }, 8000);
    return () => clearInterval(tickRef.current);
  }, []);

  function addNewToken() {
    if (!newForm.farmerName.trim()) return;
    const t = createToken(genId("FRM"), newForm.farmerName, newForm.residueType, parseInt(newForm.qty));
    setTokens(prev => [t, ...prev]);
    setShowNewModal(false);
    setNewForm({ farmerName: "", residueType: "Paddy Straw", qty: 200 });
  }

  const allFeed = tokens.flatMap(t => t.activityFeed.map(a => ({ ...a, tokenId: t.id })))
    .sort((a, b) => 0).slice(-10).reverse();

  return (
    <div style={{ fontFamily: "'Segoe UI', system-ui, sans-serif", maxWidth: 780, margin: "0 auto", padding: "0 0 40px" }}>
      <style>{`
        @keyframes pulse {
          0%, 100% { box-shadow: 0 0 0 3px rgba(55,138,221,0.2); }
          50% { box-shadow: 0 0 0 6px rgba(55,138,221,0.08); }
        }
        button:hover { opacity: 0.88; }
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-thumb { background: #ddd; border-radius: 2px; }
      `}</style>

      {/* Header */}
      <div style={{
        background: "linear-gradient(135deg, #1b5e20 0%, #2e7d32 60%, #388e3c 100%)",
        borderRadius: "0 0 18px 18px", padding: "20px 24px 22px", marginBottom: 20, color: "#fff"
      }}>
        <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: 12 }}>
          <div>
            <div style={{ fontSize: 10, letterSpacing: 3, opacity: 0.7, textTransform: "uppercase", marginBottom: 4 }}>KhetKart</div>
            <div style={{ fontSize: 20, fontWeight: 700 }}>Live Residue Tracking</div>
            <div style={{ fontSize: 12, opacity: 0.8, marginTop: 2 }}>
              {tokens.length} tokens active · {tokens.filter(t => t.currentStage === 7).length} in transit
            </div>
          </div>
          <button onClick={() => setShowNewModal(true)} style={{
            background: "rgba(255,255,255,0.2)", border: "1px solid rgba(255,255,255,0.4)",
            borderRadius: 20, padding: "8px 18px", color: "#fff", cursor: "pointer", fontSize: 13, fontWeight: 600
          }}>
            + New Listing
          </button>
        </div>
      </div>

      {/* Role switcher */}
      <div style={{ display: "flex", gap: 8, padding: "0 4px", marginBottom: 20, flexWrap: "wrap" }}>
        {ROLES.map(r => (
          <button key={r} onClick={() => setActiveRole(r)} style={{
            padding: "8px 18px", borderRadius: 20, border: "1px solid",
            borderColor: activeRole === r ? "#2e7d32" : "#e0e0e0",
            background: activeRole === r ? "#2e7d32" : "#fff",
            color: activeRole === r ? "#fff" : "#555",
            cursor: "pointer", fontWeight: 600, fontSize: 13,
            transition: "all 0.2s"
          }}>{r}</button>
        ))}
      </div>

      {/* Global activity strip */}
      <div style={{
        background: "#fff", border: "1px solid #e8e8e8", borderRadius: 12,
        padding: "12px 16px", marginBottom: 18
      }}>
        <div style={{ fontWeight: 700, fontSize: 12, color: "#888", marginBottom: 8, letterSpacing: 1, textTransform: "uppercase" }}>
          Live Supply Chain Feed
        </div>
        <ActivityFeed feed={allFeed} />
      </div>

      {/* Dashboard by role */}
      <div style={{ padding: "0 2px" }}>
        {activeRole === "Farmer" && <FarmerDashboard tokens={tokens} onAdvance={advanceToken} />}
        {activeRole === "Transporter" && <TransporterDashboard tokens={tokens} onAdvance={advanceToken} />}
        {activeRole === "Hub" && <HubDashboard tokens={tokens} onAdvance={advanceToken} />}
        {activeRole === "Buyer" && <BuyerDashboard tokens={tokens} />}
      </div>

      {/* New Token Modal */}
      {showNewModal && (
        <div style={{
          position: "fixed", inset: 0, background: "rgba(0,0,0,0.45)",
          display: "flex", alignItems: "center", justifyContent: "center", zIndex: 100
        }}>
          <div style={{
            background: "#fff", borderRadius: 16, padding: 28, width: 380,
            boxShadow: "0 8px 40px rgba(0,0,0,0.15)"
          }}>
            <div style={{ fontWeight: 700, fontSize: 17, marginBottom: 20 }}>Create New Residue Listing</div>
            <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
              <div>
                <label style={{ fontSize: 12, color: "#555", display: "block", marginBottom: 4 }}>Farmer Name</label>
                <input value={newForm.farmerName} onChange={e => setNewForm(p => ({ ...p, farmerName: e.target.value }))}
                  placeholder="e.g. Sukhwinder Singh"
                  style={{ width: "100%", padding: "8px 12px", borderRadius: 8, border: "1px solid #ddd", fontSize: 14, boxSizing: "border-box" }} />
              </div>
              <div>
                <label style={{ fontSize: 12, color: "#555", display: "block", marginBottom: 4 }}>Residue Type</label>
                <select value={newForm.residueType} onChange={e => setNewForm(p => ({ ...p, residueType: e.target.value }))}
                  style={{ width: "100%", padding: "8px 12px", borderRadius: 8, border: "1px solid #ddd", fontSize: 14 }}>
                  <option>Paddy Straw</option>
                  <option>Wheat Stubble</option>
                  <option>Sugarcane Bagasse</option>
                  <option>Corn Stover</option>
                </select>
              </div>
              <div>
                <label style={{ fontSize: 12, color: "#555", display: "block", marginBottom: 4 }}>Quantity (kg)</label>
                <input type="number" value={newForm.qty} onChange={e => setNewForm(p => ({ ...p, qty: e.target.value }))}
                  style={{ width: "100%", padding: "8px 12px", borderRadius: 8, border: "1px solid #ddd", fontSize: 14, boxSizing: "border-box" }} />
              </div>
            </div>
            <div style={{ display: "flex", gap: 10, marginTop: 22 }}>
              <button onClick={addNewToken} style={{
                flex: 1, padding: "10px", background: "#2e7d32", color: "#fff",
                border: "none", borderRadius: 10, fontWeight: 700, fontSize: 14, cursor: "pointer"
              }}>
                Create Token
              </button>
              <button onClick={() => setShowNewModal(false)} style={{
                padding: "10px 18px", background: "#f5f5f5", color: "#555",
                border: "none", borderRadius: 10, fontWeight: 600, fontSize: 14, cursor: "pointer"
              }}>
                Cancel
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}