import { useState, useEffect, useCallback, useRef } from "react";

const STAGES = [
  { id: 1, key: "listed", label: "Residue Listed", icon: "📋", role: "Farmer" },
  { id: 2, key: "cluster_created", label: "Cluster Created", icon: "🔗", role: "Platform" },
  { id: 3, key: "transport_assigned", label: "Transport Assigned", icon: "🚛", role: "Platform" },
  { id: 4, key: "pickup_started", label: "Pickup Started", icon: "🚜", role: "Transporter" },
  { id: 5, key: "pickup_confirmed", label: "Pickup Confirmed", icon: "✅", role: "Transporter" },
  { id: 6, key: "gps_captured", label: "GPS Captured", icon: "📍", role: "System" },
  { id: 7, key: "in_transit", label: "Cluster In Transit", icon: "🛣️", role: "Transporter" },
  { id: 8, key: "hub_received", label: "Hub Received", icon: "🏭", role: "Hub" },
  { id: 9, key: "processing_started", label: "Processing Started", icon: "⚙️", role: "Hub" },
  { id: 10, key: "processing_completed", label: "Processing Completed", icon: "✨", role: "Hub" },
  { id: 11, key: "payment_released", label: "Payment Released", icon: "💰", role: "Platform" },
  { id: 12, key: "token_closed", label: "Token Closed", icon: "🔒", role: "System" },
];

function genId(prefix) {
  return `${prefix}-${Math.floor(1000 + Math.random() * 9000)}`;
}

function genCoords() {
  return {
    lat: (30.5 + Math.random() * 0.5).toFixed(5),
    lng: (75.8 + Math.random() * 0.5).toFixed(5),
  };
}

function now() {
  return new Date().toLocaleString("en-IN", { hour12: true, hour: "2-digit", minute: "2-digit", day: "2-digit", month: "short" });
}

function createToken(farmerId, farmerName, residueType, qty) {
  const farmToken = genId("KKT-FRM");
  const clsToken = genId("KKT-CLS");
  const coords = genCoords();
  return {
    id: farmToken,
    clsId: clsToken,
    farmerId,
    farmerName,
    residueType,
    qty,
    currentStage: 1,
    status: "active",
    progress: 8,
    transparencyScore: 10,
    processingETA: null,
    coords,
    activityFeed: [
      { time: now(), msg: `Token ${farmToken} created for ${farmerName}`, type: "info" },
      { time: now(), msg: `Residue listing confirmed: ${qty}kg ${residueType}`, type: "success" },
    ],
    checkpoints: STAGES.map((s, i) => ({
      stageId: s.id,
      status: i === 0 ? "completed" : "pending",
      timestamp: i === 0 ? now() : null,
      stakeholder: s.role,
      coords: i === 0 ? coords : null,
    })),
    paymentAmount: (qty * 12).toFixed(0),
    paymentStatus: "pending",
  };
}

const INITIAL_TOKENS = [
  createToken("FRM-001", "Harjinder Singh", "Paddy Straw", 420),
  createToken("FRM-002", "Gurpreet Kaur", "Wheat Stubble", 280),
];
INITIAL_TOKENS[0].currentStage = 7;
INITIAL_TOKENS[0].progress = 58;
INITIAL_TOKENS[0].transparencyScore = 72;
INITIAL_TOKENS[0].processingETA = "~2 hrs";
INITIAL_TOKENS[0].checkpoints = INITIAL_TOKENS[0].checkpoints.map((c, i) => ({
  ...c,
  status: i < 7 ? "completed" : i === 7 ? "active" : "pending",
  timestamp: i < 7 ? now() : null,
  coords: i < 7 ? genCoords() : null,
}));
INITIAL_TOKENS[0].activityFeed = [
  { time: now(), msg: "Token KKT-FRM-1023 closed pending GPS sync", type: "warn" },
  { time: now(), msg: "Cluster KKT-CLS-2201 now in transit", type: "info" },
  { time: now(), msg: "Transporter Rajveer Singh confirmed pickup", type: "success" },
  { time: now(), msg: "GPS coordinates captured at Ludhiana bypass", type: "info" },
  { time: now(), msg: "Cluster created with 3 farmers merged", type: "success" },
];

const ROLES = ["Farmer", "Transporter", "Hub", "Buyer"];

const COLORS = {
  completed: { bg: "#e8f5e9", text: "#2e7d32", border: "#a5d6a7" },
  active: { bg: "#e3f2fd", text: "#1565c0", border: "#90caf9" },
  pending: { bg: "#f5f5f5", text: "#757575", border: "#e0e0e0" },
  warning: { bg: "#fff8e1", text: "#f57f17", border: "#ffe082" },
};

function Badge({ status, label }) {
  const c = COLORS[status] || COLORS.pending;
  return (
    <span style={{
      background: c.bg, color: c.text, border: `1px solid ${c.border}`,
      borderRadius: 20, padding: "2px 10px", fontSize: 11, fontWeight: 600,
      textTransform: "uppercase", letterSpacing: 0.5
    }}>{label || status}</span>
  );
}

function ProgressBar({ value }) {
  const color = value < 33 ? "#ef9f27" : value < 66 ? "#378add" : "#1d9e75";
  return (
    <div style={{ background: "#f0f0f0", borderRadius: 8, height: 8, overflow: "hidden" }}>
      <div style={{
        width: `${value}%`, height: "100%", background: color,
        transition: "width 0.6s ease", borderRadius: 8
      }} />
    </div>
  );
}

function TransparencyScore({ score }) {
  const color = score < 40 ? "#e24b4a" : score < 70 ? "#ef9f27" : "#1d9e75";
  return (
    <div style={{ textAlign: "center" }}>
      <svg width={64} height={64} viewBox="0 0 64 64">
        <circle cx={32} cy={32} r={26} fill="none" stroke="#e0e0e0" strokeWidth={5} />
        <circle cx={32} cy={32} r={26} fill="none" stroke={color} strokeWidth={5}
          strokeDasharray={`${(score / 100) * 163.4} 163.4`}
          strokeLinecap="round" transform="rotate(-90 32 32)"
          style={{ transition: "stroke-dasharray 0.8s ease" }}
        />
        <text x={32} y={37} textAnchor="middle" fontSize={14} fontWeight={700} fill={color}>{score}</text>
      </svg>
      <div style={{ fontSize: 10, color: "#888", marginTop: -4 }}>Transparency</div>
    </div>
  );
}

function ActivityFeed({ feed }) {
  return (
    <div style={{ maxHeight: 160, overflowY: "auto", display: "flex", flexDirection: "column", gap: 6 }}>
      {feed.slice().reverse().map((f, i) => {
        const c = f.type === "success" ? "#1d9e75" : f.type === "warn" ? "#ef9f27" : "#378add";
        return (
          <div key={i} style={{ display: "flex", gap: 8, alignItems: "flex-start", fontSize: 12 }}>
            <div style={{ width: 6, height: 6, borderRadius: "50%", background: c, marginTop: 4, flexShrink: 0 }} />
            <span style={{ color: "#555" }}>{f.time}</span>
            <span style={{ color: "#222", flex: 1 }}>{f.msg}</span>
          </div>
        );
      })}
    </div>
  );
}

function CheckpointTimeline({ checkpoints, tokenId, onAdvance, role }) {
  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 0 }}>
      {STAGES.map((stage, i) => {
        const cp = checkpoints[i];
        const isActive = cp.status === "active";
        const isDone = cp.status === "completed";
        const canAdvance = isActive && (
          (role === "Transporter" && [4, 5, 6, 7].includes(stage.id)) ||
          (role === "Hub" && [8, 9, 10].includes(stage.id)) ||
          (role === "Farmer" && stage.id === 1) ||
          (role === "Buyer" && false)
        );

        return (
          <div key={stage.id} style={{ display: "flex", gap: 16, position: "relative" }}>
            <div style={{ display: "flex", flexDirection: "column", alignItems: "center", width: 32 }}>
              <div style={{
                width: 28, height: 28, borderRadius: "50%",
                background: isDone ? "#1d9e75" : isActive ? "#378add" : "#e0e0e0",
                display: "flex", alignItems: "center", justifyContent: "center",
                fontSize: 13, transition: "background 0.4s",
                boxShadow: isActive ? "0 0 0 3px rgba(55,138,221,0.25)" : "none",
                animation: isActive ? "pulse 2s infinite" : "none",
                flexShrink: 0, zIndex: 1
              }}>
                {isDone ? "✓" : isActive ? "●" : stage.id}
              </div>
              {i < STAGES.length - 1 && (
                <div style={{
                  width: 2, flex: 1, minHeight: 28,
                  background: isDone ? "#1d9e75" : "#e0e0e0",
                  transition: "background 0.4s"
                }} />
              )}
            </div>
            <div style={{
              flex: 1, paddingBottom: 16,
              opacity: cp.status === "pending" ? 0.5 : 1,
              transition: "opacity 0.3s"
            }}>
              <div style={{ display: "flex", alignItems: "center", gap: 8, flexWrap: "wrap" }}>
                <span style={{ fontSize: 14, fontWeight: 600, color: "#1a1a1a" }}>{stage.label}</span>
                <Badge status={cp.status === "completed" ? "completed" : cp.status === "active" ? "active" : "pending"}
                  label={cp.status === "completed" ? "Done" : cp.status === "active" ? "In Progress" : "Pending"} />
                {cp.stakeholder && <span style={{ fontSize: 11, color: "#888", background: "#f5f5f5", borderRadius: 10, padding: "1px 8px" }}>{cp.stakeholder}</span>}
              </div>
              {cp.timestamp && <div style={{ fontSize: 11, color: "#888", marginTop: 2 }}>🕐 {cp.timestamp}</div>}
              {cp.coords && (
                <div style={{ fontSize: 11, color: "#1565c0", marginTop: 2 }}>
                  📍 {cp.coords.lat}, {cp.coords.lng}
                  <button onClick={() => alert(`Opening map: ${cp.coords.lat}, ${cp.coords.lng}\n(Map integration ready for Google Maps API)`)}
                    style={{ marginLeft: 8, fontSize: 10, padding: "1px 8px", borderRadius: 10, border: "1px solid #90caf9", background: "#e3f2fd", color: "#1565c0", cursor: "pointer" }}>
                    View Live Location
                  </button>
                </div>
              )}
              {canAdvance && (
                <button onClick={() => onAdvance(tokenId, stage.id)}
                  style={{
                    marginTop: 6, padding: "4px 14px", borderRadius: 16,
                    background: "#1d9e75", color: "#fff", border: "none",
                    fontSize: 12, cursor: "pointer", fontWeight: 600
                  }}>
                  Confirm → {stage.label}
                </button>
              )}

              {isActive && stage.id === 6 && (
                <button onClick={() => {
                  if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(
                      (pos) => onAdvance(tokenId, stage.id, { lat: pos.coords.latitude.toFixed(5), lng: pos.coords.longitude.toFixed(5) }),
                      () => onAdvance(tokenId, stage.id, genCoords())
                    );
                  } else {
                    onAdvance(tokenId, stage.id, genCoords());
                  }
                }}
                  style={{
                    marginTop: 6, padding: "4px 14px", borderRadius: 16,
                    background: "#378add", color: "#fff", border: "none",
                    fontSize: 12, cursor: "pointer", fontWeight: 600
                  }}>
                  📍 Capture GPS Location
                </button>
              )}
            </div>
          </div>
        );
      })}
    </div>
  );
}

function MapPlaceholder({ coords }) {
  return (
    <div style={{
      border: "1px dashed #90caf9", borderRadius: 12, padding: "20px 16px",
      background: "#f0f7ff", textAlign: "center", marginTop: 12
    }}>
      <div style={{ fontSize: 28 }}>🗺️</div>
      <div style={{ fontWeight: 600, fontSize: 13, color: "#1565c0", marginTop: 4 }}>Live Map Placeholder</div>
      <div style={{ fontSize: 11, color: "#555", marginTop: 4 }}>
        Ready for Google Maps API integration<br />
        Last known: {coords ? `${coords.lat}, ${coords.lng}` : "N/A"}
      </div>
      <div style={{ marginTop: 8, display: "flex", gap: 8, justifyContent: "center" }}>
        <span style={{ fontSize: 10, background: "#e3f2fd", color: "#1565c0", padding: "2px 8px", borderRadius: 10 }}>Live GPS feed ready</span>
        <span style={{ fontSize: 10, background: "#e8f5e9", color: "#2e7d32", padding: "2px 8px", borderRadius: 10 }}>Route tracking enabled</span>
