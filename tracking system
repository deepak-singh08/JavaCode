}

function TokenCard({ token, expanded, onToggle, onAdvance, role }) {
  const stage = STAGES.find(s => s.id === token.currentStage);
  const isCompleted = token.currentStage === 12 && token.checkpoints[11].status === "completed";

  return (
    <div style={{
      border: "1px solid #e0e0e0", borderRadius: 14,
      background: "#fff", overflow: "hidden",
      boxShadow: expanded ? "0 4px 20px rgba(0,0,0,0.08)" : "none",
      transition: "box-shadow 0.3s"
    }}>
      <div onClick={onToggle} style={{
        padding: "14px 18px", cursor: "pointer",
        background: isCompleted ? "#f1f8e9" : "#fff",
        borderBottom: expanded ? "1px solid #f0f0f0" : "none",
        display: "flex", alignItems: "center", gap: 12, flexWrap: "wrap"
      }}>
        <div>
          <div style={{ display: "flex", gap: 8, alignItems: "center", marginBottom: 4 }}>
            <span style={{ fontFamily: "monospace", fontWeight: 700, fontSize: 13, color: "#1565c0" }}>{token.id}</span>
            <span style={{ fontFamily: "monospace", fontSize: 11, color: "#888" }}>{token.clsId}</span>
            {isCompleted && <Badge status="completed" label="Closed" />}
            {token.paymentStatus === "pending" && !isCompleted && <Badge status="warning" label="Payment Pending" />}
          </div>
          <div style={{ fontSize: 13, color: "#444" }}>
            {token.farmerName} · {token.qty}kg {token.residueType}
          </div>
          <div style={{ fontSize: 12, color: "#888", marginTop: 2 }}>
            Stage: {stage?.label} · ETA: {token.processingETA || "Calculating..."}
          </div>
        </div>
        <div style={{ marginLeft: "auto", display: "flex", gap: 16, alignItems: "center" }}>
          <TransparencyScore score={token.transparencyScore} />
          <div style={{ minWidth: 100 }}>
            <div style={{ fontSize: 11, color: "#888", marginBottom: 4 }}>{token.progress}% complete</div>
            <ProgressBar value={token.progress} />
          </div>
          <span style={{ fontSize: 18, color: "#888" }}>{expanded ? "▲" : "▼"}</span>
        </div>
      </div>

      {expanded && (
        <div style={{ padding: "16px 18px", display: "flex", flexDirection: "column", gap: 16 }}>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 10 }}>
            {[
              { label: "Token ID", val: token.id, color: "#1565c0" },
              { label: "Cluster ID", val: token.clsId, color: "#6a1b9a" },
              { label: "Payment", val: `₹${token.paymentAmount}`, color: token.paymentStatus === "released" ? "#2e7d32" : "#e65100" },
              { label: "Residue", val: `${token.qty}kg ${token.residueType}`, color: "#555" },
              { label: "ETA", val: token.processingETA || "TBD", color: "#555" },
              { label: "Transparency", val: `${token.transparencyScore}/100`, color: token.transparencyScore > 70 ? "#2e7d32" : "#e65100" },
            ].map(({ label, val, color }) => (
              <div key={label} style={{ background: "#f9f9f9", borderRadius: 8, padding: "8px 12px" }}>
                <div style={{ fontSize: 11, color: "#888" }}>{label}</div>
                <div style={{ fontSize: 13, fontWeight: 600, color }}>{val}</div>
              </div>
            ))}
          </div>

          <MapPlaceholder coords={token.coords} />

          <div>
            <div style={{ fontWeight: 700, fontSize: 13, marginBottom: 10, color: "#333" }}>Supply Chain Journey</div>
            <CheckpointTimeline
              checkpoints={token.checkpoints}
              tokenId={token.id}
              onAdvance={onAdvance}
              role={role}
            />
          </div>

          <div>
            <div style={{ fontWeight: 700, fontSize: 13, marginBottom: 8, color: "#333" }}>Live Activity Feed</div>
            <ActivityFeed feed={token.activityFeed} />
          </div>
        </div>
      )}
    </div>
  );
}

function FarmerDashboard({ tokens, onAdvance }) {
  const [expandedId, setExpandedId] = useState(null);
  const active = tokens.filter(t => t.currentStage < 12);
  const completed = tokens.filter(t => t.currentStage === 12 && t.checkpoints[11]?.status === "completed");
  const paymentPending = tokens.filter(t => t.paymentStatus === "pending" && t.currentStage > 1);

  return (
    <div>
      <div style={{ display: "grid", gridTemplateColumns: "repeat(4, 1fr)", gap: 10, marginBottom: 20 }}>
        {[
          { label: "Active Tokens", val: active.length, color: "#1565c0" },
          { label: "Completed", val: completed.length, color: "#2e7d32" },
          { label: "Payment Pending", val: paymentPending.length, color: "#e65100" },
          { label: "Total Residue", val: `${tokens.reduce((s, t) => s + t.qty, 0)}kg`, color: "#6a1b9a" },
        ].map(({ label, val, color }) => (
          <div key={label} style={{ background: "#fff", border: "1px solid #e8e8e8", borderRadius: 10, padding: "12px 14px" }}>
            <div style={{ fontSize: 11, color: "#888" }}>{label}</div>
            <div style={{ fontSize: 22, fontWeight: 700, color }}>{val}</div>
          </div>
        ))}
